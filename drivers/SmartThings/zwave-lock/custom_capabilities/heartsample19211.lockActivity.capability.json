        "required": ["value"]
      },
      "enumCommands": []
    },
    "userIndex": {
      "schema": {
        "type": "object",
        "properties": {"value": {"type": "integer", "minimum": 0}},
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    },
    "message": {
      "schema": {
        "type": "object",
        "properties": {"value": {"type": "string"}},
        "additionalProperties": false,
        "required": ["value"]
      },
      "enumCommands": []
    }
  },
  "commands": {}
}
